{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Day3GroundedAnswer",
  "description": "Structured, cited answer produced by the Day 3 grounded generation layer. Enforces that a 'high'/'medium' confidence answer cannot ship with empty evidence or citations.",
  "type": "object",
  "required": ["status", "recommendation", "supporting_evidence", "citations", "confidence", "missing_information", "safety_note"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["answered", "insufficient_evidence", "safety_refusal"]
    },
    "recommendation": {
      "type": "string",
      "minLength": 1
    },
    "supporting_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim", "citations"],
        "properties": {
          "claim": {"type": "string", "minLength": 1},
          "citations": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["document", "section", "page", "chunk_id"],
        "properties": {
          "document": {"type": "string"},
          "section": {"type": "string"},
          "page": {"type": ["number", "string"]},
          "chunk_id": {"type": "string"}
        }
      }
    },
    "confidence": {
      "type": "string",
      "enum": ["High", "Medium", "Low", "Insufficient Evidence"]
    },
    "missing_information": {
      "type": "array",
      "items": {"type": "string"}
    },
    "safety_note": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"confidence": {"enum": ["High", "Medium"]}}
      },
      "then": {
        "properties": {
          "supporting_evidence": {"type": "array", "minItems": 1},
          "citations": {"type": "array", "minItems": 1}
        }
      }
    },
    {
      "if": {
        "properties": {"status": {"const": "answered"}}
      },
      "then": {
        "properties": {
          "supporting_evidence": {"type": "array", "minItems": 1},
          "citations": {"type": "array", "minItems": 1}
        }
      }
    },
    {
      "if": {
        "properties": {"status": {"enum": ["insufficient_evidence", "safety_refusal"]}}
      },
      "then": {
        "properties": {
          "supporting_evidence": {"type": "array", "maxItems": 0},
          "citations": {"type": "array", "maxItems": 0},
          "confidence": {"const": "Insufficient Evidence"}
        }
      }
    }
  ]
}
